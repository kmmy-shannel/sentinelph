# ---------- API ----------
VITE_API_URL=http://localhost:4000

# ---------- Firebase Web SDK ----------
# Get these from: Firebase Console → Project Settings → General → Your apps → Web app
VITE_FIREBASE_API_KEY=REPLACE_WITH_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=REPLACE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=REPLACE_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_SENDER_ID
VITE_FIREBASE_APP_ID=REPLACE_APP_ID