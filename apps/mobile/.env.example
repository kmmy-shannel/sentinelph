# ---------- API ----------
# Use your machine's LAN IP so the Expo app can reach the local API
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000

# ---------- Firebase Web SDK ----------
EXPO_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_PROJECT_ID.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_PROJECT_ID
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=REPLACE_PROJECT_ID.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_SENDER_ID
EXPO_PUBLIC_FIREBASE_APP_ID=REPLACE_APP_ID